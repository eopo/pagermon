# Pagermon Ingest Service Configuration

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
INGEST__REDIS_URL=redis://redis:6379

# ============================================================================
# SDR INGEST CONFIGURATION (RTL-FM + Multimon-NG)
# ============================================================================

# Frequencies to receive (comma-separated, e.g., "163000000,161887500")
# REQUIRED
INGEST__FREQUENCIES=163000000

# Optional: RTL-SDR device gain (0-49.6, auto-detect if not set)
INGEST__GAIN=30

# Optional: Squelch level (in dB, required if multiple frequencies)
INGEST__SQUELCH=2.5

# Optional: PPM correction for RTL-SDR
INGEST__PPM=0

# Protocol(s) to decode (comma-separated, e.g., "POCSAG512,POCSAG1200,FLEX")
# REQUIRED
INGEST__PROTOCOLS=POCSAG512

# Optional: Character set (e.g., "UTF-8", "ASCII")
# INGEST__CHARSET=UTF-8

# Optional: Decoder output format passed to multimon-ng -f
# Use multimon-ng terms like alpha, numeric, num, gpn.
INGEST__FORMAT=alpha

# Optional: RTL-SDR device index (0 for first device)
# INGEST__DEVICE=0

# Label to identify this ingest agent in messages
INGEST__LABEL=sdr-ingest-1

# ============================================================================
# PAGERMON API CONFIGURATION
# ============================================================================

# URL of the PagerMon API server
# REQUIRED
INGEST__API_URL=http://pagermon:3000

# API key for authentication with PagerMon
# REQUIRED
INGEST__API_KEY=your_api_key_here

# ============================================================================
# OPTIONAL: ADVANCED FEATURES
# ============================================================================

# Enable Dead Letter Queue for permanent failures (default: true)
INGEST__ENABLE_DLQ=true

# Circuit breaker configuration
# Number of consecutive failures before circuit opens (default: 5)
INGEST__CIRCUIT_BREAKER_THRESHOLD=5

# Time in milliseconds to wait before attempting recovery (default: 30000)
INGEST__CIRCUIT_BREAKER_TIMEOUT=30000
